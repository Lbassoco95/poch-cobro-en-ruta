# Marcadores. Los valores reales NUNCA van en el repositorio.
# Secretos de las Edge Functions (se configuran como secretos de Supabase)
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# Opcional. Solo si la llave de pey NO está ligada a una cuenta.
# Si la llave ya está ligada, no lo envíe: un valor incorrecto da BANK_ACCOUNT_NOT_FOUND.
PEY_BANK_ACCOUNT_ID=
# Comprobante público del cliente (no son secretos sensibles de API)
PEY_CUENTA_ULTIMOS4=
PEY_EMPRESA_NOMBRE=Empresa Demo
SITE_URL=
# Frontend (variables de Vercel; solo la llave pública)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
